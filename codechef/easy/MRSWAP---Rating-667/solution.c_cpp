#include <bits/stdc++.h>
using namespace std;

void solve() {
    
    int N;
    cin >> N;
    
	vector<int> a(2*N);
	
	for(int i=0 ; i<2*N ; i++) {
	    cin >> a[i] ;}
	    
	int max_sum = 0;
	for(int i=0 ; i<N ; i++) {
	    max_sum += max(a[i] , a[2*N - 1 - i]); }
    cout << max_sum << "\n" ;
	
	
	
	
	

}
int main() {
    int T;
    cin >> T;
    while(T--) {
        solve() ;
    }
    return 0;
}
